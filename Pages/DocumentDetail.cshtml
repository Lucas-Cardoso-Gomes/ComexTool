@page "{id:guid}"
@model ComexTool.Pages.DocumentDetailModel
@{
    ViewData["Title"] = "Detalhes do Documento";
    var doc = Model.Doc!;
    var data = doc.ExtractedData;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3>@doc.FileName</h3>
        <span class="badge bg-secondary me-2">@doc.Type</span>
        <span class="text-muted small">Enviado em @doc.UploadedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
    </div>
    <div class="d-flex gap-2">
        <a href="/api/documents/download/@doc.Id" class="btn btn-sm btn-outline-secondary" download>Download</a>
        <a asp-page="/Documents" class="btn btn-sm btn-outline-primary">Voltar</a>
    </div>
</div>

@if (data == null)
{
    <div class="alert alert-warning">
        Nenhum dado foi extraído automaticamente deste documento. Pode ser um PDF sem texto pesquisável (escaneado) ou uma imagem.
    </div>
}
else
{
    <div class="row g-3">

        @* ============ IDENTIFICAÇÃO GERAL ============ *@
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-primary text-white fw-semibold">Identificação Geral</div>
                <div class="card-body p-3">
                    @await Html.PartialAsync("_FieldRow", ("Nº Documento", data.NumeroDocumento))
                    @await Html.PartialAsync("_FieldRow", ("Data Emissão", data.DataEmissao))
                    @await Html.PartialAsync("_FieldRow", ("NCM", data.NCM))
                    @await Html.PartialAsync("_FieldRow", ("Incoterm", data.Incoterm))
                    @await Html.PartialAsync("_FieldRow", ("Moeda", data.Moeda))
                    @await Html.PartialAsync("_FieldRow", ("Valor Total", data.ValorTotal))
                    @await Html.PartialAsync("_FieldRow", ("Peso Bruto", data.PesoBruto))
                    @await Html.PartialAsync("_FieldRow", ("Peso Líquido", data.PesoLiquido))
                    @await Html.PartialAsync("_FieldRow", ("Volume (m³)", data.VolumeTotalM3))
                </div>
            </div>
        </div>

        @* ============ EXPORTADOR ============ *@
        @if (data.Exportador != null)
        {
            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-success text-white fw-semibold">Exportador / Remetente</div>
                    <div class="card-body p-3">
                        @await Html.PartialAsync("_ParticipanteCard", data.Exportador)
                    </div>
                </div>
            </div>
        }

        @* ============ IMPORTADOR ============ *@
        @if (data.Importador != null)
        {
            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-info text-white fw-semibold">Importador / Comprador</div>
                    <div class="card-body p-3">
                        @await Html.PartialAsync("_ParticipanteCard", data.Importador)
                    </div>
                </div>
            </div>
        }

        @* ============ CONSIGNATÁRIO ============ *@
        @if (data.Consignatario != null)
        {
            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-secondary text-white fw-semibold">Consignatário</div>
                    <div class="card-body p-3">
                        @await Html.PartialAsync("_ParticipanteCard", data.Consignatario)
                    </div>
                </div>
            </div>
        }

        @* ============ TRANSPORTADOR ============ *@
        @if (data.Transportador != null)
        {
            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-warning text-dark fw-semibold">Transportador</div>
                    <div class="card-body p-3">
                        @await Html.PartialAsync("_ParticipanteCard", data.Transportador)
                        @await Html.PartialAsync("_FieldRow", ("Placa Caminhão", data.Transportador.PlacaCaminhao))
                        @await Html.PartialAsync("_FieldRow", ("Placa Reboque", data.Transportador.PlacaReboque))
                        @await Html.PartialAsync("_FieldRow", ("ANTT", data.Transportador.RegistroANTT))
                    </div>
                </div>
            </div>
        }

        @* ============ NF-e ============ *@
        @if (data.Nfe != null)
        {
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-dark text-white fw-semibold">Nota Fiscal Eletrônica (NF-e)</div>
                    <div class="card-body p-3">
                        <div class="row">
                            <div class="col-md-6">
                                @await Html.PartialAsync("_FieldRow", ("Chave de Acesso", data.Nfe.ChaveAcesso))
                                @await Html.PartialAsync("_FieldRow", ("Número NF", data.Nfe.NumeroNF))
                                @await Html.PartialAsync("_FieldRow", ("Série", data.Nfe.Serie))
                                @await Html.PartialAsync("_FieldRow", ("Natureza Operação", data.Nfe.NaturezaOperacao))
                                @await Html.PartialAsync("_FieldRow", ("Data Emissão", data.Nfe.DataEmissao))
                                @await Html.PartialAsync("_FieldRow", ("Protocolo Autorização", data.Nfe.ProtocoloAutorizacao))
                            </div>
                            <div class="col-md-6">
                                @await Html.PartialAsync("_FieldRow", ("Base Cálculo ICMS", data.Nfe.BaseCalculoICMS))
                                @await Html.PartialAsync("_FieldRow", ("Valor ICMS", data.Nfe.ValorICMS))
                                @await Html.PartialAsync("_FieldRow", ("Valor Total Produtos", data.Nfe.ValorTotalProdutos))
                                @await Html.PartialAsync("_FieldRow", ("Valor Frete", data.Nfe.ValorFrete))
                                @await Html.PartialAsync("_FieldRow", ("Valor IPI", data.Nfe.ValorIPI))
                                @await Html.PartialAsync("_FieldRow", ("Valor Total NF", data.Nfe.ValorTotalNF))
                                @await Html.PartialAsync("_FieldRow", ("Peso Bruto", data.Nfe.PesoBruto))
                                @await Html.PartialAsync("_FieldRow", ("Peso Líquido", data.Nfe.PesoLiquido))
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        @* ============ FATURA COMERCIAL ============ *@
        @if (data.FaturaComercial != null)
        {
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-dark text-white fw-semibold">Fatura Comercial</div>
                    <div class="card-body p-3">
                        <div class="row">
                            <div class="col-md-6">
                                @await Html.PartialAsync("_FieldRow", ("Nº Fatura", data.FaturaComercial.NumeroFatura))
                                @await Html.PartialAsync("_FieldRow", ("Data Fatura", data.FaturaComercial.DataFatura))
                                @await Html.PartialAsync("_FieldRow", ("Data Embarque", data.FaturaComercial.DataEmbarque))
                                @await Html.PartialAsync("_FieldRow", ("Incoterm", data.FaturaComercial.Incoterm))
                                @await Html.PartialAsync("_FieldRow", ("Cond. Pagamento", data.FaturaComercial.CondicoesPagamento))
                                @await Html.PartialAsync("_FieldRow", ("Origem", data.FaturaComercial.OrigemEmbarque))
                                @await Html.PartialAsync("_FieldRow", ("Destino", data.FaturaComercial.DestinoFinal))
                            </div>
                            <div class="col-md-6">
                                @await Html.PartialAsync("_FieldRow", ("Moeda", data.FaturaComercial.MoedaOperacao))
                                @await Html.PartialAsync("_FieldRow", ("Taxa Câmbio", data.FaturaComercial.TaxaCambio))
                                @await Html.PartialAsync("_FieldRow", ("Meio Transporte", data.FaturaComercial.MeioTransporte))
                                @await Html.PartialAsync("_FieldRow", ("Container", data.FaturaComercial.NumeroContainer))
                                @await Html.PartialAsync("_FieldRow", ("Valor Total", data.FaturaComercial.ValorTotalFatura))
                                @await Html.PartialAsync("_FieldRow", ("Valor Frete", data.FaturaComercial.ValorFrete))
                                @await Html.PartialAsync("_FieldRow", ("Valor Seguro", data.FaturaComercial.ValorSeguro))
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        @* ============ DU-E ============ *@
        @if (data.Due != null)
        {
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-dark text-white fw-semibold">DU-E</div>
                    <div class="card-body p-3">
                        <div class="row">
                            <div class="col-md-6">
                                @await Html.PartialAsync("_FieldRow", ("Nº DU-E", data.Due.NumeroDUE))
                                @await Html.PartialAsync("_FieldRow", ("RUC", data.Due.RUC))
                                @await Html.PartialAsync("_FieldRow", ("Forma Exportação", data.Due.FormaExportacao))
                                @await Html.PartialAsync("_FieldRow", ("País Importador", data.Due.PaisImportador))
                            </div>
                            <div class="col-md-6">
                                @await Html.PartialAsync("_FieldRow", ("Moeda Negociação", data.Due.MoedaNegociacao))
                                @await Html.PartialAsync("_FieldRow", ("VMLE", data.Due.VMLE))
                                @await Html.PartialAsync("_FieldRow", ("VMCV", data.Due.VMCV))
                                @await Html.PartialAsync("_FieldRow", ("Valor Total R$", data.Due.ValorTotalReais))
                                @await Html.PartialAsync("_FieldRow", ("Peso Líquido", data.Due.PesoLiquidoTotal))
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        @* ============ CRT / MIC-DTA ============ *@
        @if (data.Crt != null)
        {
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-dark text-white fw-semibold">CRT / MIC-DTA</div>
                    <div class="card-body p-3">
                        <div class="row">
                            <div class="col-md-6">
                                @await Html.PartialAsync("_FieldRow", ("Nº CRT", data.Crt.NumeroCRT))
                                @await Html.PartialAsync("_FieldRow", ("Nº MIC/DTA", data.Crt.NumeroMICDTA))
                                @await Html.PartialAsync("_FieldRow", ("Destino", data.Crt.CidadeDestino))
                                @await Html.PartialAsync("_FieldRow", ("País Destino", data.Crt.PaisDestino))
                            </div>
                            <div class="col-md-6">
                                @await Html.PartialAsync("_FieldRow", ("Valor FOB", data.Crt.ValorFOB))
                                @await Html.PartialAsync("_FieldRow", ("Frete Internacional", data.Crt.ValorFreteInternacional))
                                @await Html.PartialAsync("_FieldRow", ("Peso Bruto", data.Crt.PesoBruto))
                                @await Html.PartialAsync("_FieldRow", ("Peso Líquido", data.Crt.PesoLiquido))
                                @await Html.PartialAsync("_FieldRow", ("Lacres", data.Crt.LacresCarga))
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        @* ============ CERTIFICADO DE ORIGEM ============ *@
        @if (data.CertificadoOrigem != null)
        {
            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-dark text-white fw-semibold">Certificado de Origem</div>
                    <div class="card-body p-3">
                        @await Html.PartialAsync("_FieldRow", ("Nº Certificado", data.CertificadoOrigem.NumeroCertificado))
                        @await Html.PartialAsync("_FieldRow", ("Entidade Emissora", data.CertificadoOrigem.EntidadeEmissora))
                        @await Html.PartialAsync("_FieldRow", ("Acordo", data.CertificadoOrigem.AcordoComercial))
                        @await Html.PartialAsync("_FieldRow", ("País Destino", data.CertificadoOrigem.PaisDestino))
                    </div>
                </div>
            </div>
        }

        @* ============ PACKING LIST ============ *@
        @if (data.PackingList != null)
        {
            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-dark text-white fw-semibold">Packing List / Rastreabilidade</div>
                    <div class="card-body p-3">
                        @await Html.PartialAsync("_FieldRow", ("SKU / Código", data.PackingList.SKU))
                        @await Html.PartialAsync("_FieldRow", ("Lote", data.PackingList.NumeroLote))
                        @await Html.PartialAsync("_FieldRow", ("Fabricação", data.PackingList.DataFabricacao))
                        @await Html.PartialAsync("_FieldRow", ("Validade", data.PackingList.DataValidade))
                        @await Html.PartialAsync("_FieldRow", ("SIF", data.PackingList.NumeroSIF))
                        @await Html.PartialAsync("_FieldRow", ("Calibre", data.PackingList.Calibre))
                    </div>
                </div>
            </div>
        }

        @* ============ ITENS ============ *@
        @if (data.Itens != null && data.Itens.Count > 0)
        {
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-dark text-white fw-semibold">Itens de Mercadoria (@data.Itens.Count encontrados)</div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-sm table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>#</th>
                                        <th>NCM</th>
                                        <th>Descrição</th>
                                        <th>Unidade</th>
                                        <th>CFOP</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @for (int i = 0; i < data.Itens.Count; i++)
                                {
                                    var item = data.Itens[i];
                                    <tr>
                                        <td>@(i + 1)</td>
                                        <td><code>@item.NCM</code></td>
                                        <td>@(item.DescricaoProduto ?? "—")</td>
                                        <td>@(item.UnidadeMedida ?? "—")</td>
                                        <td>@(item.CFOP ?? "—")</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        }

        @* ============ CONDUTOR / DESPACHANTE ============ *@
        @if (!string.IsNullOrWhiteSpace(data.CondutorNome) || !string.IsNullOrWhiteSpace(data.DespachanteNome))
        {
            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-secondary text-white fw-semibold">Outros Participantes</div>
                    <div class="card-body p-3">
                        @await Html.PartialAsync("_FieldRow", ("Condutor", data.CondutorNome))
                        @await Html.PartialAsync("_FieldRow", ("CPF Condutor", data.CondutorCpf))
                        @await Html.PartialAsync("_FieldRow", ("Despachante", data.DespachanteNome))
                        @await Html.PartialAsync("_FieldRow", ("CPF Despachante", data.DespachanteCpf))
                    </div>
                </div>
            </div>
        }

    </div>

    @* ============ TEXTO EXTRAÍDO ============ *@
    @if (!string.IsNullOrWhiteSpace(doc.ExtractedText))
    {
        <div class="mt-4">
            <details>
                <summary class="fw-semibold text-muted">Ver texto bruto extraído do documento</summary>
                <pre class="bg-light p-3 mt-2 rounded small" style="max-height: 400px; overflow-y: auto;">@doc.ExtractedText</pre>
            </details>
        </div>
    }
}
