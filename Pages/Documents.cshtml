@page
@model ComexTool.Pages.DocumentsModel
@{
    ViewData["Title"] = "Documentos Cadastrados";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Documentos Cadastrados</h2>
        <span class="text-muted small">Todos os documentos analisados individualmente</span>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="/Processes" class="btn btn-outline-primary">📁 Ver por Processo</a>
        <a asp-page="/Upload" class="btn btn-primary">+ Novo Upload</a>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Tipo</th>
                    <th>Arquivo</th>
                    <th>Processo</th>
                    <th>NCM</th>
                    <th>Incoterm</th>
                    <th>Valor / Moeda</th>
                    <th>Data Upload</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var doc in Model.Documents)
            {
                var data = doc.ExtractedData;
                <tr>
                    <td><span class="badge bg-secondary">@doc.Type</span></td>
                    <td>
                        <a asp-page="/DocumentDetail" asp-route-id="@doc.Id" class="text-decoration-none fw-semibold">
                            @doc.FileName
                        </a>
                        @if (!string.IsNullOrWhiteSpace(doc.ExtractedText))
                        {
                            <span class="badge bg-info text-dark ms-1" title="Texto extraído com sucesso">Analisado</span>
                        }
                    </td>
                    <td>
                        @if (doc.Processo != null)
                        {
                            <a asp-page="/ProcessDetail" asp-route-id="@doc.Processo.Id" class="badge bg-primary text-decoration-none">
                                @doc.Processo.NumeroProcesso
                            </a>
                        }
                        else
                        {
                            <span class="text-muted small fst-italic">Avulso</span>
                        }
                    </td>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(data?.NCM))
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle font-monospace">@data.NCM</span>
                        }
                        else
                        {
                            <span class="text-muted small fst-italic">—</span>
                        }
                    </td>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(data?.Incoterm))
                        {
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">@data.Incoterm</span>
                        }
                        else
                        {
                            <span class="text-muted small fst-italic">—</span>
                        }
                    </td>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(data?.ValorTotal))
                        {
                            <span class="small fw-semibold">@(data.Moeda ?? "") @data.ValorTotal</span>
                        }
                        else
                        {
                            <span class="text-muted small fst-italic">—</span>
                        }
                    </td>
                    <td>@doc.UploadedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                    <td class="text-end">
                        <a asp-page="/DocumentDetail" asp-route-id="@doc.Id" class="btn btn-sm btn-outline-primary me-1" title="Visualizar ou Atualizar">
                            Análise Individual
                        </a>
                        <form method="post" asp-page-handler="DeleteDocument" asp-route-id="@doc.Id" class="d-inline" onsubmit="return confirm('Apagar este documento permanentemente?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Apagar Documento">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@if (!Model.Documents.Any())
{
    <div class="text-center p-5 bg-light rounded mt-3">
        <p class="text-muted mb-3">Nenhum documento cadastrado ainda.</p>
        <a asp-page="/Upload" class="btn btn-primary">Fazer primeiro Upload</a>
    </div>
}
