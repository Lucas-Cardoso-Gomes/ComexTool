@page
@model IndexModel
@{
    ViewData["Title"] = "Visão Geral COMEX";
}

<div class="row align-items-center mb-5 mt-2">
    <div class="col-lg-8">
        <h1 class="display-5 fw-bold text-dark">Auditoria e Análise de Processos COMEX</h1>
        <p class="lead text-muted">
            Solução inteligente para extração profunda de dados e cruzamento comparativo entre
            <strong>Fatura Comercial, Packing List, CSI, NF-e, CRT, MIC/DTA, DU-E e Certificado de Origem</strong>.
        </p>
        <div class="d-flex gap-2 mt-3">
            <a class="btn btn-primary btn-lg px-4" asp-page="/Upload">
                <i class="bi bi-cloud-arrow-up"></i> Iniciar Análise por Processo
            </a>
            <a class="btn btn-outline-dark btn-lg px-4" asp-page="/Processes">
                <i class="bi bi-folder2-open"></i> Ver Processos Cadastrados
            </a>
        </div>
    </div>
    <div class="col-lg-4 text-center d-none d-lg-block">
        <div class="p-4 bg-light rounded-circle d-inline-block shadow-sm">
            <i class="bi bi-shield-check text-primary" style="font-size: 5rem;"></i>
        </div>
    </div>
</div>

<div class="row g-4 mb-5">
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm p-3">
            <div class="card-body">
                <div class="text-primary fs-3 mb-2"><i class="bi bi-file-earmark-diff"></i></div>
                <h5 class="fw-bold">Análise Individual Profunda</h5>
                <p class="text-muted small">
                    Extração de mais de 80 campos específicos: atores (Exportador, Importador, Consignatário, Transportador, Condutor, Despachante), impostos (ICMS, IPI), pesos, itens com NCM e taxas.
                </p>
                <a asp-page="/Documents" class="stretched-link text-decoration-none fw-semibold">Ver Documentos &rarr;</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm p-3">
            <div class="card-body">
                <div class="text-success fs-3 mb-2"><i class="bi bi-diagram-3"></i></div>
                <h5 class="fw-bold">Comparativo Cruzado</h5>
                <p class="text-muted small">
                    Matriz de auditoria que compara em tempo real os valores de Fatura vs CRT vs NF-e, pesos brutos e líquidos, dados do veículo e conformidade do Certificado de Origem e CSI.
                </p>
                <a asp-page="/Processes" class="stretched-link text-decoration-none fw-semibold">Acessar Processos &rarr;</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm p-3">
            <div class="card-body">
                <div class="text-warning fs-3 mb-2"><i class="bi bi-exclamation-triangle"></i></div>
                <h5 class="fw-bold">Deteção de Divergências</h5>
                <p class="text-muted small">
                    Alertas instantâneos para diferenças de valores FOT/FOB, pesos divergentes no packing list, divergência de placas de caminhão ou razão social entre os intervenientes.
                </p>
                <a asp-page="/Upload" class="stretched-link text-decoration-none fw-semibold">Fazer Upload &rarr;</a>
            </div>
        </div>
    </div>
</div>
